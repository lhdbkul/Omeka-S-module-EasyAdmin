<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \EasyAdmin\Form\CheckAndFixForm $form
 */

$plugins = $this->getHelperPluginManager();
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$escape = $plugins->get('escapeHtml');

$form->setAttribute('data-db-loop-warning', $translate('A query combined with “All” resource types is applied identically to every type; filters unsupported by a type are ignored.'));
$form->setAttribute('data-filter-placeholder', $translate('Filter tasks…'));

// Prepare subject metadata (name, description, action verbs), merged from core
// and from modules that added theirs through the "form.add_elements" event.
// Tasks without metadata fall back to grouped radios (split on ":") in the js.
$subjectsData = [];
foreach ($form->getTaskSubjects() as $subjectKey => $subject) {
    $actions = [];
    foreach ($subject['actions'] ?? [] as $processValue => $verb) {
        $actions[$processValue] = $translate($verb);
    }
    $subjectsData[$subjectKey] = [
        'name' => $translate($subject['name'] ?? $subjectKey),
        'description' => isset($subject['description']) ? $translate($subject['description']) : '',
        'actions' => $actions,
    ];
}
$form->setAttribute('data-subjects', json_encode($subjectsData, JSON_UNESCAPED_UNICODE));

$form->prepare();

$this->htmlElement('body')->appendAttribute('class', 'easy-admin check-and-fix browse');

$this->headLink()
    ->appendStylesheet($assetUrl('css/easy-admin.css', 'EasyAdmin'));
$this->headScript()
    ->appendFile($assetUrl('js/easy-admin.js', 'EasyAdmin'), 'text/javascript', ['defer' => 'defer'])
    ->appendFile($assetUrl('js/check-and-fix.js', 'EasyAdmin'), 'text/javascript', ['defer' => 'defer'])
;
?>

<?= $this->pageTitle($translate('Check and fix'), 1, $translate('Easy Admin')) ?>

<nav class="section-nav">
    <?= $this->navigation('Laminas\Navigation\EasyAdmin')->menu() ?>
</nav>

<?= $this->form()->openTag($form) ?>
<?= $this->formCollection($form) ?>

<aside class="sidebar always-open" id="cf-sidebar">
    <div class="task-help">
        <h3><?= $escape($translate('How it works')) ?></h3>
        <p><?= $escape($translate('Select a task on the left. Most tasks offer a “Check” action and a “Fix” action. The check is always safe, but it is recommended to do a backup when processing deep fixes.')) ?></p>
        <p><?= $escape($translate('Normal tasks are listed by default. Tick the box below to list only the dangerous tasks and risky options instead.')) ?></p>
        <p class="task-toggle-dangerous">
            <label>
                <input type="checkbox" id="toggle_tasks_with_warning">
                <?= $escape($translate('Show only dangerous tasks and risky options')) ?>
            </label>
        </p>
    </div>
    <div class="task-recap" hidden>
        <h3 class="task-recap-name"></h3>
        <p class="task-recap-desc"></p>
        <div class="task-recap-actions"></div>
        <div class="task-recap-options"></div>
    </div>
    <div class="cf-sidebar-footer">
        <button type="submit" class="button"><?= $translate('Submit') ?></button>
    </div>
</aside>
<?= $this->form()->closeTag() ?>
